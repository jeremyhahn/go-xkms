# Dockerfile.xkmsd — builds xkmsd with -tags raft for the 3-node cluster
# integration test harness.
#
# The image is purpose-built for the cluster test: it bakes the raft-tagged
# binary into the image so the compose stack can start three identical nodes
# with only environment-variable differences. Build context is the repo root;
# sibling module trees are provided via docker compose additional_contexts.

FROM golang:1.26.6-bookworm AS builder

ENV GOTOOLCHAIN=auto

# Build dependencies for CGO (PKCS#11 support pulled in transitively).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libusb-1.0-0-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy module manifests for cache-efficient dependency download.
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/
COPY xkey/go.mod xkey/go.sum ./xkey/

# Materialise the sibling modules from docker compose additional_contexts.
COPY --from=go-codec     . /go-codec
COPY --from=go-frost     . /go-frost
COPY --from=go-objstore  . /go-objstore
COPY --from=go-qrdb      . /go-qrdb
COPY --from=go-quicraft  . /go-quicraft
COPY --from=go-truststrap . /go-truststrap

# Write a build-time Go workspace via the single canonical generator
# (scripts/gen-gowork.sh) so all in-house modules resolve locally and the
# replace set cannot drift. Repo root is /build here.
ENV GOWORK=/tmp/go.work
COPY scripts/gen-gowork.sh ./scripts/gen-gowork.sh
RUN bash scripts/gen-gowork.sh /build /tmp/go.work

RUN go mod download

# Copy the full source tree.
COPY . .

# Build xkmsd with the raft tag so NewClusteredNode is available.
RUN CGO_ENABLED=1 go build -buildvcs=false \
    -tags "raft pkcs8 codec_cbor codec_json codec_msgpack" \
    -ldflags "-w -s" \
    -o /out/xkmsd \
    ./cmd/xkmsd/

# ──────────────────────────────────────────────────────────────────────────────
# Runtime image: Debian bookworm slim for glibc compatibility with the CGO
# binary. We do not use Alpine because the CGO binary links against glibc.
# ──────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/xkmsd /app/xkmsd

# Data directory created at runtime; cluster nodes each get a named volume.
RUN mkdir -p /data/storage /data/keys/pkcs8 /etc/xkms

EXPOSE 8443
EXPOSE 63001

HEALTHCHECK --interval=5s --timeout=3s --retries=20 --start-period=10s \
    CMD wget --quiet --tries=1 --spider http://localhost:8443/health || exit 1

ENTRYPOINT ["/app/xkmsd"]
