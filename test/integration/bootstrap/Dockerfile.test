FROM golang:1.27.3-bookworm
# apt retries transient fetch errors with backoff (go-xkms#342).
COPY build/docker/devcontainer/apt-retries.conf /etc/apt/apt.conf.d/80-retries
ENV GOTOOLCHAIN=auto

# Base deps for the bootstrap protocol tests (truststrap package) plus
# CGO headers required when the xkey TrustService integration test
# transitively pulls in xkey/pkg/gui/services (USB/HID/CBOR/PKCS11).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    pkg-config \
    libusb-1.0-0-dev \
    libudev-dev \
    libcbor-dev \
    libhidapi-dev \
    libpcsclite-dev \
    && rm -rf /var/lib/apt/lists/*

ENV GOWORK=off

WORKDIR /workspace

# Bake the source into the image at build time rather than relying on the
# compose file's runtime bind mount (`volumes: - ../../..:/workspace`). On
# the Gitea Actions runner, that relative path resolves against the JOB
# CONTAINER's filesystem, which the HOST docker daemon doesn't share -- the
# mount silently succeeds against an unrelated (often empty) host directory
# instead of erroring, leaving /workspace without a go.mod (same failure
# class runner-log-proven for test/integration/pkcs8, task 3001).
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/
COPY xkey/go.mod xkey/go.sum ./xkey/

RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then . /run/secrets/gomodauth; fi; \
    go mod download

COPY . .
