# Dockerfile for DNS-01 Challenge Responder (Mock DNS Server)
FROM golang:1.27.3-alpine AS builder

WORKDIR /build

# Copy DNS responder source
COPY cmd/dns_responder.go .

# Initialize module and build
RUN go mod init dns-responder && \
    go get github.com/miekg/dns && \
    CGO_ENABLED=0 GOOS=linux go build -o dns-responder .

# Final stage
# alpine:3.24 rather than :latest: a floating base changes under CI without a
# commit, so a base regression reads as a code regression. The minor-series tag
# still receives patches and the upgrade below takes them on every rebuild --
# a patch-level pin would freeze the security fixes too.
FROM alpine:3.24

RUN apk --no-cache upgrade && \
    apk --no-cache add wget bind-tools

# Create non-root user for security
RUN addgroup -g 1000 dnsresponder && \
    adduser -u 1000 -G dnsresponder -s /bin/sh -D dnsresponder

WORKDIR /app

COPY --from=builder /build/dns-responder .

# Set ownership for non-root user
RUN chown -R dnsresponder:dnsresponder /app

ENV DNS_PORT=53
ENV HTTP_PORT=8053

EXPOSE 53/udp
EXPOSE 8053

# Switch to non-root user
USER dnsresponder

CMD ["./dns-responder"]
