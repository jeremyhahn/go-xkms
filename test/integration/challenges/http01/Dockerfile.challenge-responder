# Dockerfile for HTTP-01 Challenge Responder
FROM golang:1.27.4-alpine AS builder

WORKDIR /build

# Copy challenge responder source
COPY cmd/challenge_responder.go .

# Initialize module and build
RUN go mod init challenge-responder && \
    CGO_ENABLED=0 GOOS=linux go build -o challenge-responder .

# Final stage
# alpine:3.24 rather than :latest: a floating base changes under CI without a
# commit, so a base regression reads as a code regression. The minor-series tag
# still receives patches and the upgrade below takes them on every rebuild --
# a patch-level pin would freeze the security fixes too.
FROM alpine:3.24

RUN apk --no-cache upgrade && \
    apk --no-cache add wget

# Create non-root user for security
RUN addgroup -g 1000 challenge && \
    adduser -u 1000 -G challenge -s /bin/sh -D challenge

WORKDIR /app

COPY --from=builder /build/challenge-responder .

# Create challenge directory
RUN mkdir -p /challenges

# Set ownership for non-root user
RUN chown -R challenge:challenge /app /challenges

ENV LISTEN_PORT=80
ENV CHALLENGE_DIR=/challenges

EXPOSE 80

# Switch to non-root user
USER challenge

CMD ["./challenge-responder"]
