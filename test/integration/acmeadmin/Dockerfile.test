# SoftHSM 2.7.0 from its pinned, checksum-verified release
# (scripts/build-softhsm.sh) instead of Debian's 2.6.1, which answers an AES-GCM
# tag mismatch with the ambiguous CKR_GENERAL_ERROR so PKCS#11 tamper could not
# be classified as types.ErrSealedDataAuthentication (go-xkms#1418).
FROM golang:1.27.3-bookworm AS softhsm
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake libtool libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/build-softhsm.sh /build/build-softhsm.sh
RUN DESTDIR=/build/softhsm-install sh /build/build-softhsm.sh

FROM golang:1.27.3-bookworm
ENV GOTOOLCHAIN=auto

# Build deps for xkmsctl's cgo backends (pkcs11, tpm2) — matches Dockerfile.cli.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libtss2-dev \
    libicu-dev \
    libusb-1.0-0-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV GOWORK=off

# SoftHSM 2.7.0: /usr/lib/softhsm/libsofthsm2.so, softhsm2-util, /etc/softhsm.
COPY --from=softhsm /build/softhsm-install/ /

WORKDIR /workspace

# Bake the source into the image at build time, matching
# test/integration/bootstrap/Dockerfile.test: a runtime bind mount resolves
# against the wrong filesystem on a Gitea Actions runner (see that file's
# comment).
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/
COPY xkey/go.mod xkey/go.sum ./xkey/

RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then . /run/secrets/gomodauth; fi; \
    go mod download

COPY . .

RUN CGO_ENABLED=1 go build -buildvcs=false \
        -tags="pkcs8,tpm2,pkcs11,awskms,gcpkms,azurekv,vault" \
        -o /usr/local/bin/xkmsctl \
        ./cmd/xkmsctl

RUN test -f /usr/local/bin/xkmsctl || (echo "ERROR: xkmsctl binary not built" && exit 1)
