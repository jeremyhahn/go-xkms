# Sample OpenSSL 4.0.1 configuration that activates the pkcs11-provider
# module built against that OpenSSL (see build/docker/devcontainer/Dockerfile) so a
# PKCS#11 module can be driven through the provider interface, e.g.:
#
#   PKCS11_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so \
#     OPENSSL_CONF=/usr/local/openssl-4.0.1/ssl/openssl-pkcs11.cnf \
#     openssl list -providers
#
# PKCS11_MODULE_PATH must point at the PKCS#11 .so to load (SoftHSM,
# OpenSC, or the xkms PKCS#11 module itself). Not baked in as the
# container-wide default OPENSSL_CONF so that unrelated `openssl` usage in
# the image keeps OpenSSL's normal default-only provider behavior.
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
pkcs11 = pkcs11_sect

[default_sect]
activate = 1

[pkcs11_sect]
module = /usr/local/openssl-4.0.1/lib/ossl-modules/pkcs11.so
pkcs11-module-path = ${ENV::PKCS11_MODULE_PATH}
# SoftHSM 2.6.1's own atexit-registered cleanup can segfault inside
# C_CloseSession when it runs after libcrypto's OPENSSL_cleanup(), which
# OpenSSL 4.0 now invokes from a global destructor rather than atexit()
# (see NEWS.md for openssl-4.0.0: "libcrypto no longer cleans up globally
# allocated data via atexit()" / "OPENSSL_cleanup() now runs in a global
# destructor"). That reordering only affects process-exit teardown, not
# any cryptographic operation, but it still means a non-zero `openssl`
# exit code even though the operation itself succeeded. `no-deinit` is
# pkcs11-provider's documented workaround (provider-pkcs11(7)): it skips
# the provider's own PKCS#11 deinit on shutdown, avoiding the crash.
pkcs11-module-quirks = no-deinit
activate = 1
