# Multi-stage Dockerfile for go-xkms CLI tool
# Production-ready with security best practices

# Stage 1: Builder
FROM golang:1.26.6-bookworm AS builder

ENV GOTOOLCHAIN=auto

# Install build dependencies. libicu-dev/libusb-1.0-0-dev are cgo build deps
# of the module graph itself (dolthub/go-icu-regex, google/gousb via
# go-qrdb), not gated by any of this image's backend tags.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libsofthsm2 \
    libsofthsm2-dev \
    softhsm2 \
    libtss2-dev \
    libicu-dev \
    libusb-1.0-0-dev \
    ca-certificates \
    file \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy go module files for better layer caching
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/

# Copy the xkey module files before go mod download (required for the
# replace directive: go.mod replaces github.com/jeremyhahn/go-xkms/xkey with
# ./xkey, and go mod download reads that go.mod even though this image
# never builds xkey itself).
COPY xkey/go.mod xkey/go.sum ./xkey/

# In-house modules resolve from Gitea tags (dependency-resolution.md §6). The
# fetch token arrives as a BuildKit secret, never a build arg or ENV: a build
# arg is recorded in image metadata, while a secret is mounted on tmpfs for
# this RUN alone and never becomes a layer. It is sourced rather than
# exported so the value never appears in a command line either. The mount is
# optional by design: with no secret supplied these modules resolve from the
# public proxy once tags are mirrored (§7), so the same Dockerfile builds on
# both hosts.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then . /run/secrets/gomodauth; fi; \
    go mod download

# Copy source code
COPY . .

# Build the CLI with all backend tags enabled
ARG VERSION
ARG COMMIT
ARG DATE
ARG TARGETARCH

RUN CGO_ENABLED=1 GOOS=linux go build \
        -buildvcs=false \
        -tags="pkcs8,tpm2,pkcs11,awskms,gcpkms,azurekv,vault" \
        -ldflags="-X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE} -s -w" \
        -o /build/xkms-cli \
        ./cmd/xkmsctl

# Verify binary was built
RUN test -f /build/xkms-cli || (echo "ERROR: CLI binary not built" && exit 1)

# Stage 2: Runtime
FROM debian:bookworm-slim

LABEL maintainer="go-xkms"
LABEL description="Production xkms CLI tool"
LABEL org.opencontainers.image.source="https://github.com/jeremyhahn/go-xkms"
LABEL org.opencontainers.image.description="CLI tool for xkms operations"
LABEL org.opencontainers.image.vendor="go-xkms"

# Install runtime dependencies.
#
# `apt-get upgrade -y` before the install, matching Dockerfile.server and the
# three protocol images (go-xkms#135): a pinned base is a REPRODUCIBLE base,
# not a patched one -- debian:bookworm-slim is rebuilt only periodically, so
# without this the image ships whatever CVEs the base snapshot carried. This
# is the image published as xkms-cli, so the gap reached a release artifact.
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    libsofthsm2 \
    softhsm2 \
    libtss2-esys-3.0.2-0 \
    libtss2-tcti-device0 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 xkms

# Create required directories
RUN mkdir -p /etc/xkms /var/lib/xkms /var/lib/softhsm/tokens && \
    chown -R xkms:xkms /etc/xkms /var/lib/xkms /var/lib/softhsm

# Copy binary from builder
COPY --from=builder /build/xkms-cli /usr/local/bin/xkms-cli

# Switch to non-root user
USER xkms

# Set working directory
WORKDIR /home/xkms

# Volume for persistent data
VOLUME ["/var/lib/xkms", "/etc/xkms"]

# Environment variables
ENV KEYSTORE_CONFIG=/etc/xkms/config.yaml

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/xkms-cli"]

# Default command - show help
CMD ["--help"]
