# Virtual-hardware BLE integration test image.
#
# Provides two emulated Bluetooth LE controllers backed by the kernel's
# hci_vhci driver and BlueZ's btvirt controller emulator, plus a real
# bluetoothd on a private D-Bus system bus. That is enough for the xKey GATT
# peripheral to advertise on one controller and for the xKey central to
# connect over the other, exercising the notify path against real HCI.
#
# btvirt is not shipped in the Ubuntu bluez package (it is a noinst_PROGRAM),
# so it is built from the matching BlueZ release.

FROM ubuntu:24.04

ENV GOTOOLCHAIN=auto
ENV DEBIAN_FRONTEND=noninteractive

# Install Go from the official tarball.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && GOVERSION=$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -1) \
    && curl -fsSL "https://go.dev/dl/${GOVERSION}.linux-amd64.tar.gz" | tar -C /usr/local -xz \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"

# Runtime: kernel module tools, BlueZ daemon and CLI, D-Bus.
# Build: toolchain and BlueZ build dependencies for btvirt.
RUN apt-get update && apt-get install -y --no-install-recommends \
    kmod \
    bluez \
    bluez-tools \
    dbus \
    xz-utils \
    git \
    build-essential \
    pkg-config \
    automake \
    libtool \
    libglib2.0-dev \
    libdbus-1-dev \
    libudev-dev \
    libical-dev \
    libreadline-dev \
    libusb-1.0-0-dev \
    libpcsclite-dev \
    && rm -rf /var/lib/apt/lists/*

# Build btvirt, BlueZ's userspace controller emulator. It attaches emulated
# controllers to /dev/vhci and links them over a loopback "phy" so they can
# advertise to and connect with each other.
#
# The lib/bluetooth/*.h copy stages BlueZ's own BUILT_SOURCES: they satisfy
# the <bluetooth/bluetooth.h> includes and are only generated by a full
# "make", while this build asks for the single btvirt target.
ARG BLUEZ_VERSION=5.72
RUN curl -fsSL "https://mirrors.edge.kernel.org/pub/linux/bluetooth/bluez-${BLUEZ_VERSION}.tar.xz" -o /tmp/bluez.tar.xz \
    && mkdir -p /tmp/bluez && tar -C /tmp/bluez --strip-components=1 -xf /tmp/bluez.tar.xz \
    && cd /tmp/bluez \
    && mkdir -p lib/bluetooth && cp lib/*.h lib/bluetooth/ \
    && ./configure --enable-testing --disable-manpages --disable-systemd \
        --disable-udev --disable-cups --disable-obex >/dev/null \
    && make -j"$(nproc)" emulator/btvirt \
    && cp emulator/btvirt /usr/local/bin/btvirt \
    && rm -rf /tmp/bluez /tmp/bluez.tar.xz

WORKDIR /src

# Copy go module files first for better layer caching.
COPY go.mod go.sum ./

# Copy sub-module go.mod/go.sum files required by replace directives.
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/
COPY xkey/go.mod xkey/go.sum ./xkey/

# Copy local replace directive dependencies.
COPY --from=go-qrdb . /go-qrdb/
COPY --from=go-quicraft . /go-quicraft/
COPY --from=go-truststrap . /go-truststrap/
COPY --from=go-codec . /go-codec/
COPY --from=go-frost . /go-frost/
COPY --from=go-objstore . /go-objstore/

RUN cd xkey && go mod download

# Copy full source.
COPY . .

COPY xkey/test/integration/ble/entrypoint.sh /usr/local/bin/ble-entrypoint.sh
RUN chmod +x /usr/local/bin/ble-entrypoint.sh

WORKDIR /src/xkey

ENTRYPOINT ["/usr/local/bin/ble-entrypoint.sh"]
