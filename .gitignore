# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Log files
*.log

# Build artifacts. build/docker/ holds the devcontainer (handbook
# devcontainer.md §1) and is source.
/build/*
!/build/docker/
/dist/
/bin/

# Go workspace files
go.work
go.work.sum

# Test coverage
*.coverprofile
coverage.html
coverage.out
# Web coverage reports (vitest/istanbul): CI artifacts regenerated by every
# `npm run test:coverage`, never source (#454).
/sdk/ts/coverage/
/sdk/ts/svelte-auth/coverage/
/web/app/coverage/

# npm dependency trees are installed from the lockfiles, never committed.
node_modules/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Keystore test data
/test/testdata/keys/
/test/testdata/tokens/
/test/integration/keys/
/test/integration/tokens/

# Docker volumes
/.docker-data/

# Azure Key Vault emulator certificates
/.azure-emulator/

# Claude Code
# CLAUDE.md is tracked (owner ruling 2026-08-18) — it is the repo's agent
# contract and AGENTS.md symlinks to it. Keep it free of internal hosts,
# addresses, workstation paths and agent principal names.
.claude/

# Serena (semantic code-retrieval tooling). .serena/project.yml and
# .serena/memories/ are committed. Memories are published like docs/, so they
# must carry no internal hosts, addresses, workstation paths or agent principal
# names (#170). The cache and project.local.yml are per machine and per checkout.
.serena/cache/
.serena/project.local.yml

# SoftHSM2 test files
softhsm2.conf
softhsm2/

# Audit sink written by the server's default audit path when tests or a
# local run start it from the repo (zero-byte artifact, never a source file)
audit-events.ndjson

# Node.js / Playwright
node_modules/
test-results/
playwright-report/

# Binary outputs (root only, not cmd/ directories)
/xkmsd
/xkmsctl
/truststrap
# `go build ./examples/certificates/hardware/hybrid` from the root
/hybrid

# compiled binaries never enter the module tree (module zip size limit)
/acme-client
/pkcs11-module
# `go build` inside a cmd/ directory writes the binary next to its source
/cmd/acme-client/acme-client
/cmd/pkcs11-module/pkcs11-module
/cmd/xkmsctl/xkmsctl
/cmd/xkmsd/xkmsd
/xkey/cmd/e2eprobe/e2eprobe
/xkey/cmd/xkey/xkey
/server
/x25519-ecdh
/aes
/chacha20
/encryption
test/integration/acme-client/playwright/trusted-acme-client

# Gitea module-fetch token (dependency-resolution.md §6) — never committed
build/docker/devcontainer/.env
build/docker/devcontainer/.env.tmp
build/docker/devcontainer/gomodauth.env
# The pre-#1558 location: a checkout upgraded across the move keeps its old
# .devcontainer/.env, which must stay ignored.
.devcontainer/.env
.devcontainer/.env.tmp
.devcontainer/gomodauth.env
# The repo root copy too: ci.yml's docker job stages the same credentials as
# ./gomodauth.env (`make stage-gomodauth` writes only the build/docker/devcontainer path),
# so reproducing that job locally left a token file untracked but NOT ignored
# — one `git add -A` from history, which under version-control.md means
# rotating the token rather than rewriting the commit. .dockerignore already
# covered `gomodauth*`; this closes the git side.
gomodauth.env

# *.test above matches Go test binaries; these are DOCKERFILES whose
# names happen to end in .test — without this negation they are silently
# unignorable and were never committed at all.
!test/integration/**/Dockerfile.test

# xkey ssh store written into the repo root by a manual run with the data
# directory set to "ssh" (#453). Runtime state, never source.
/ssh/
