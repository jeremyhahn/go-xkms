# Multi-stage Dockerfile for go-xkms gRPC-only server
# Production-ready with security best practices

# Stage 1: Builder
FROM golang:1.27.0-bookworm AS builder

# Allow Go to automatically download the required toolchain version
ENV GOTOOLCHAIN=auto

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    tzdata \
    gcc \
    libc6-dev \
    pkg-config \
    opensc \
    && rm -rf /var/lib/apt/lists/*

# SoftHSM 2.7.0 for the runtime stage, from its pinned, checksum-verified
# release (scripts/build-softhsm.sh) instead of Debian's 2.6.1, which answers an
# AES-GCM tag mismatch with the ambiguous CKR_GENERAL_ERROR (go-xkms#1418).
# The xkms binary itself needs no SoftHSM to build: PKCS#11 modules are
# dlopen()ed at run time.
COPY scripts/build-softhsm.sh /build/build-softhsm.sh
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake libtool libssl-dev && \
    rm -rf /var/lib/apt/lists/* && \
    DESTDIR=/build/softhsm-install sh /build/build-softhsm.sh

# Set working directory
WORKDIR /build

# Copy go module files for better layer caching
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/

# Copy the xkey module files before go mod download (required for the replace
# directive: go.mod replaces github.com/jeremyhahn/go-xkms/xkey with ./xkey,
# and go mod download reads that go.mod even though this image never builds
# xkey itself).
COPY xkey/go.mod xkey/go.sum ./xkey/

# Download dependencies. In-house modules resolve from Gitea tags
# (dependency-resolution.md §6). The fetch token arrives as a BuildKit secret,
# never a build arg or ENV, so it never becomes a layer. The mount is optional
# by design: with no secret supplied these modules resolve from the public
# proxy once tags are mirrored (§7).
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then . /run/secrets/gomodauth; fi; \
    go mod download && go mod verify

# Copy source code
COPY . .

# Build the gRPC server with all backend tags enabled
# CGO_ENABLED=1 required for PKCS#11 support
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -buildvcs=false \
    -tags "pkcs8,tpm2,awskms,gcpkms,azurekv,vault,pkcs11" \
    -ldflags="-w -s -X main.version=${VERSION:-dev} -X main.commit=${COMMIT:-unknown} -X main.date=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    -o /build/xkms-grpc-server \
    ./cmd/xkmsd/

# Verify binary was built
RUN test -f /build/xkms-grpc-server || (echo "ERROR: gRPC server binary not built" && exit 1)

# Stage 2: Runtime
# debian:bookworm-slim rather than alpine: the builder is golang:1.27.0-bookworm
# with CGO_ENABLED=1 (required for PKCS#11), so the binary is glibc-linked and
# cannot exec at all on musl. This is the runtime Dockerfile.cli and the image
# release.yml builds and scans already use. The tag follows bookworm point
# releases and the upgrade below takes advisories on every rebuild, so the base
# is reproducible to a suite without freezing its CVEs in place.
FROM debian:bookworm-slim

LABEL maintainer="go-xkms"
LABEL description="Production xkms server with gRPC support"
LABEL org.opencontainers.image.source="https://github.com/jeremyhahn/go-xkms"
LABEL org.opencontainers.image.description="gRPC-only xkms server"
LABEL org.opencontainers.image.vendor="go-xkms"

# Install runtime dependencies
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    libssl3 \
    opensc \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 appuser && \
    useradd -m -u 1000 -g appuser appuser

# Create required directories
RUN mkdir -p /app /etc/xkms /var/lib/xkms /data && \
    chown -R appuser:appuser /app /etc/xkms /var/lib/xkms /data

# SoftHSM 2.7.0 built in the builder stage: /usr/lib/softhsm/libsofthsm2.so,
# the softhsm2-* utilities and /etc/softhsm.
COPY --from=builder /build/softhsm-install/ /

# Copy binary from builder
COPY --from=builder --chown=appuser:appuser /build/xkms-grpc-server /app/xkms-grpc-server

# Switch to non-root user
USER appuser

# Set working directory
WORKDIR /app

# Expose gRPC port
EXPOSE 9443

# Health check - check if gRPC server is listening
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD netstat -an | grep 9443 || exit 1

# Volume for persistent data
VOLUME ["/var/lib/xkms", "/etc/xkms"]

# Environment variables
ENV KEYSTORE_CONFIG=/etc/xkms/config.yaml

# Set entrypoint
ENTRYPOINT ["/app/xkms-grpc-server"]

# Default command (can be overridden)
CMD ["--port", "9443", "--data-dir", "/var/lib/xkms"]
